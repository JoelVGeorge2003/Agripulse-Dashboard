generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CommodityCategory {
  GRAIN
  OILSEED
  FIBER
  SPECIALTY
  LIVESTOCK
}

enum SyncStatus {
  RUNNING
  SUCCESS
  PARTIAL
  FAILED
}

enum ChatRole {
  USER
  ASSISTANT
  SYSTEM
}

model Commodity {
  id           String              @id @default(cuid())
  slug         String              @unique
  name         String
  symbol       String              @unique
  category     CommodityCategory
  defaultUnit  String
  color        String              @default("#2f7d32")
  description  String?
  featured     Boolean             @default(false)
  displayOrder Int                 @default(99)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  prices       CommodityPrice[]
  production   ProductionRecord[]

  @@index([category])
  @@index([name])
  @@index([featured, displayOrder])
}

model CommodityPrice {
  id             String     @id @default(cuid())
  commodityId    String
  commodity      Commodity  @relation(fields: [commodityId], references: [id], onDelete: Cascade)
  stateCode      String     @default("US")
  value          Decimal    @db.Decimal(18, 4)
  previousValue  Decimal?   @db.Decimal(18, 4)
  changePercent  Decimal?   @db.Decimal(9, 4)
  unit           String
  priceDate      DateTime
  source         String
  sourceRecordId String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@unique([commodityId, stateCode, priceDate, source])
  @@index([commodityId, priceDate(sort: Desc)])
  @@index([stateCode, priceDate(sort: Desc)])
}

model ProductionRecord {
  id             String     @id @default(cuid())
  commodityId    String
  commodity      Commodity  @relation(fields: [commodityId], references: [id], onDelete: Cascade)
  stateCode      String
  year           Int
  value          Decimal    @db.Decimal(22, 2)
  unit           String
  plantedAcres   Decimal?   @db.Decimal(18, 2)
  harvestedAcres Decimal?   @db.Decimal(18, 2)
  yieldValue     Decimal?   @db.Decimal(18, 4)
  totalValueUsd  Decimal?   @db.Decimal(22, 2)
  unitPriceUsd   Decimal?   @db.Decimal(18, 6)
  source         String
  sourceRecordId String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@unique([commodityId, stateCode, year, source])
  @@index([commodityId, year, value(sort: Desc)])
  @@index([stateCode, year])
}

model DataSourceSync {
  id                 String     @id @default(cuid())
  sourceName         String
  status             SyncStatus @default(RUNNING)
  startedAt          DateTime   @default(now())
  finishedAt         DateTime?
  pricesUpserted     Int        @default(0)
  productionUpserted Int        @default(0)
  message            String?

  @@index([sourceName, startedAt(sort: Desc)])
}

model ChatSession {
  id        String        @id @default(cuid())
  title     String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  messages  ChatMessage[]
}

model ChatMessage {
  id        String      @id @default(cuid())
  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      ChatRole
  content   String      @db.Text
  metadata  Json?
  createdAt DateTime    @default(now())

  @@index([sessionId, createdAt])
}

model FarmProfile {
  id                    String   @id @default(cuid())
  name                  String
  stateCode             String
  countyFips            String?
  cropSlug              String
  acres                 Decimal? @db.Decimal(14, 2)
  irrigationType        String?
  expectedYieldPerAcre  Decimal? @db.Decimal(14, 4)
  fuelCostPerAcre       Decimal? @db.Decimal(12, 2)
  fertilizerCostPerAcre Decimal? @db.Decimal(12, 2)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  recommendations       Recommendation[]
  scenarios             ScenarioRun[]

  @@index([stateCode, cropSlug])
}

model Recommendation {
  id                String   @id @default(cuid())
  farmProfileId     String?
  farmProfile       FarmProfile? @relation(fields: [farmProfileId], references: [id], onDelete: SetNull)
  stateCode         String
  cropSlug          String
  action            String
  reason            String
  confidence        Int
  estimatedImpact   Json
  alternativeAction String?
  inputs            Json
  rulesUsed         Json
  sources           Json
  limitations       Json
  createdAt         DateTime @default(now())
  feedback          RecommendationFeedback[]

  @@index([stateCode, cropSlug, createdAt(sort: Desc)])
}

model RecommendationFeedback {
  id               String   @id @default(cuid())
  recommendationId String
  recommendation   Recommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)
  helpful          Boolean
  followed         Boolean?
  outcome          String?
  comment          String?
  createdAt        DateTime @default(now())

  @@index([recommendationId, createdAt])
}

model ScenarioRun {
  id            String   @id @default(cuid())
  farmProfileId String?
  farmProfile   FarmProfile? @relation(fields: [farmProfileId], references: [id], onDelete: SetNull)
  stateCode     String
  cropSlug      String
  baseline      Json
  changes       Json
  results       Json
  assumptions   Json
  createdAt     DateTime @default(now())

  @@index([stateCode, cropSlug, createdAt(sort: Desc)])
}

model KnowledgeDocument {
  id           String   @id @default(cuid())
  title        String
  publisher    String
  sourceUrl    String
  documentType String
  jurisdiction String?
  cropSlugs    String[]
  publishedAt  DateTime?
  contentHash  String   @unique
  status       String   @default("ACTIVE")
  metadata     Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  chunks       KnowledgeChunk[]

  @@index([publisher, documentType])
  @@index([status, updatedAt(sort: Desc)])
}

model KnowledgeChunk {
  id         String   @id @default(cuid())
  documentId String
  document   KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  chunkIndex Int
  content    String   @db.Text
  tokenCount Int
  metadata   Json?
  createdAt  DateTime @default(now())

  @@unique([documentId, chunkIndex])
  @@index([documentId, chunkIndex])
}
